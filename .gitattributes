# Force LF for all text files
* text eol=lf

# Unity-specific files
*.cs        text eol=lf
*.shader    text eol=lf
*.compute   text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf

*.meta      text eol=lf
*.asset    text eol=lf
*.prefab   text eol=lf
*.unity    text eol=lf

# Binary files (do not modify)
*.png binary
*.jpg binary
*.fbx binary
*.wav binary
*.mp3 binary

